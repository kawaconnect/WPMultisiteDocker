# Secrets
.env

# Persistent data
data/

# Logs
logs/

# Auto-generated tunnel compose (regenerated by cf-setup.sh)
docker-compose.tunnels.yml

# Editor artifacts
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.vscode/
.idea/

# Plugin development (separate repo)
plugindev/

# Media files (screenshots, recordings)
*.mp4
*.webm
*.webp
*.png
*.jpg
*.jpeg

# Node / Playwright dependencies (regenerate with `npm install`)
node_modules/

# Generated site-audit output (regenerate by re-running the audit harness)
sites/_audit/screenshots/
sites/_audit/reports/

# Local safety copies and backup bundles, may contain real site data / DB dumps.
# NEVER commit: these leak user data (password hashes, PII) to the remote.
safety-backups/
*.sql
*.sql.gz
docs/*.zip
sgbackup_bundle_*.zip

# Temp files
*.tmp
*.bak


# wpops (node agent): per-node state, pulled backup sets, per-node config
state/
backups/
config/wpops.json
__pycache__/
*.pyc
# Isolated dev/test instances (scripts/instance.sh), contain DBs and secrets
instances/

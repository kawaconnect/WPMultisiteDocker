# =============================================================================
# WordPress Multisite + Cloudflared, Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values, then: chmod 600 .env
# NEVER commit .env to version control.
#
# Replace every changeme_ value before the first start (openssl rand -hex 24).
# Use letters and digits only for passwords: the values are substituted into
# the Compose file and wp-config.php, where quotes, $ and spaces break.
# =============================================================================

# --- MariaDB ---
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=changeme_db_password

# --- WordPress ---
WORDPRESS_DB_HOST=mariadb:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=changeme_db_password
WORDPRESS_TABLE_PREFIX=wp_

# --- WordPress deployment mode (legacy root project) ---
WP_MODE=multisite
# Set single for one single-site root project. For independent projects or a
# mixture, use wpops stack create; see docs/deployments.md.

# --- Multisite Mode ---
# Choose ONE of the two modes below.
#
# SUBDOMAIN MODE (sites are separate domains: example-primary.com, example-shop.com)
#   This matches the production setup. WordPress core handles domain mapping
#   natively via the wp_blogs table, no SUNRISE or domain mapping plugin needed.
WP_SUBDOMAIN_INSTALL=true
WP_DOMAIN_CURRENT_SITE=example.com
WP_SUNRISE=false
#
# SUBDIRECTORY MODE (sites are paths: example.com/site1, example.com/site2)
#   Simpler infra, no wildcard DNS needed. Set WP_SUNRISE=true if using a domain
#   mapping plugin (Mercator, etc.), and install sunrise.php in wp-content/.
# WP_SUBDOMAIN_INSTALL=false
# WP_DOMAIN_CURRENT_SITE=example.com
# WP_SUNRISE=true

# --- Redis (object cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password

# --- Cloudflare Tunnels ---
# Token setup: see docs/cloudflare-token-setup.md for required permissions
# Global CF settings
CF_STANDBY_DOMAIN=your-standby-domain.com
CF_CLOUD_IP=20.x.x.x

# Account 1 (standby)
#   The standby account owns the standby domain. Its tunnel serves
#   *.standby-domain.com so you can preview sites without touching real DNS.
#   DOMAINS is optional, omit to auto-discover all active zones from the API.
CF_ACCOUNT_1_NAME=standby-account
CF_ACCOUNT_1_ID=your-cloudflare-account-id
CF_ACCOUNT_1_TOKEN=your-cloudflare-api-token
CF_ACCOUNT_1_STANDBY=true
CF_ACCOUNT_1_DOMAINS=your-standby-domain.com

# Account 2 (failover)
#   Non-standby accounts hold real customer domains. Their tunnels stay idle
#   until you run cf-failover.sh. FAILOVER lists domains that are inactive
#   until failover is triggered (subset of DOMAINS). Omit or leave empty
#   if all domains on this account should be active on standby.
#   DOMAINS is optional, omit to auto-discover all active zones from the API.
CF_ACCOUNT_2_NAME=client-account
CF_ACCOUNT_2_ID=your-cloudflare-account-id
CF_ACCOUNT_2_TOKEN=your-cloudflare-api-token
CF_ACCOUNT_2_STANDBY=false
CF_ACCOUNT_2_DOMAINS=clientsite.com,another-client.com
CF_ACCOUNT_2_FAILOVER=another-client.com

# Add more accounts by incrementing the number:
# CF_ACCOUNT_3_NAME=...
# CF_ACCOUNT_3_ID=...
# CF_ACCOUNT_3_TOKEN=...
# CF_ACCOUNT_3_STANDBY=false
# CF_ACCOUNT_3_DOMAINS=example.com    # Optional: omit to auto-discover

# COMPOSE_FILE is set automatically by cf-setup.sh:
# COMPOSE_FILE=docker-compose.yml:docker-compose.tunnels.yml

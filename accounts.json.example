{
  "_comment": "Cloudflare automation config, copy to accounts.json and fill in real values",

  "standby_domain": "your-standby-domain.com",
  "cloud_ip": "20.x.x.x",

  "accounts": [
    {
      "name": "standby-account",
      "account_id": "your-cloudflare-account-id",
      "api_token": "your-cloudflare-api-token",
      "is_standby": true,
      "domains": [
        {
          "name": "your-standby-domain.com"
        }
      ]
    },
    {
      "name": "client-account",
      "account_id": "your-cloudflare-account-id",
      "api_token": "your-cloudflare-api-token",
      "is_standby": false,
      "domains": [
        {
          "name": "clientsite.com",
          "failover": false,
          "_comment": "failover: false (default) = ACTIVE, routed through standby tunnel now"
        },
        {
          "name": "another-client.com",
          "failover": true,
          "_comment": "failover: true = INACTIVE, configs ready, only touched when failover is triggered"
        }
      ]
    }
  ]
}

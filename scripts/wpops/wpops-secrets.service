# wpops secrets cache, install with: scripts/wpops/install-agent.sh
# At boot, reads this node's 1Password references once (one batched call) into
# the tmpfs cache /run/wpops/cache, before the agent starts. It never fails the
# boot: running containers do not need it, and the agent keeps retrying with
# backoff and alerts once if 1Password stays unreachable.
[Unit]
Description=wpops 1Password secrets cache (tmpfs)
After=network-online.target
Wants=network-online.target
Before=wpops-agent.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/docker/wordpressmultisite
Environment=WPOPS_REPO_DIR=/opt/docker/wordpressmultisite
ExecStart=/opt/docker/wordpressmultisite/scripts/wpops/bin/wpops secrets refresh --boot
TimeoutStartSec=300
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
